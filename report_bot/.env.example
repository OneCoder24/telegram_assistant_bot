# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (получить на https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Прокси для Telegram (опционально, если Telegram заблокирован)
# Формат: socks5://user:pass@host:port или http://user:pass@host:port
# Пример: socks5://username:password@proxy.example.com:1080
PROXY_URL=

# Путь к базе данных (опционально)
DATABASE_PATH=bot.db
